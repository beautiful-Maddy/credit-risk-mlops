{
  "family": "credit-risk-task",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "1024",
  "memory": "2048",
  "runtimePlatform": 
  {
    "cpuArchitecture": "X86_64",
    "operatingSystemFamily": "LINUX"
  },
  "executionRoleArn": "arn:aws:iam::350381001374:role/ecsTaskExecutionRole",
  "containerDefinitions": [
    {
      "name": "credit-risk-app",
      "image": "350381001374.dkr.ecr.eu-west-3.amazonaws.com/credit-risk-app:latest",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 8501,
          "protocol": "tcp"
        }
      ]
    }
  ]
}